disable_pd_cookies: false

command topic thread settings:
  default:
    prio: 50 
    affinity: [ 0, 1, 2, 3 ]

device classes:
- name: jr3
  class parameters:
  - name: jr3_module
  - name: jr3_channel
  type: pd_mapping
  clk_id: "%(jr3_channel)"
  pd_module: "%(jr3_module)"
  pd_offset: "%(jr3_channel)"
  measurements:
  - uint16_t: cnt
  - double[3]: force
    string_format: "%7.3f"
  - double[3]: torque
    string_format: "%7.3f"

devices:
- name: jr3_0
  device class: jr3
  jr3_module: jr3
  jr3_channel: 0

