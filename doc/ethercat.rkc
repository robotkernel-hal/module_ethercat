# Configuration file for module_ethercat.
#
# vim: set ft=yaml

#########################################################
# network interface settings

# Defines the interface name of the EtherCAT master network
# controller
#ifname: p1p1

# Setting realtime priorities for the receive thread of
# the EtherCAT master.
#recv_prio: 82
#recv_mask: 0x02

#########################################################
# logging settings

# Standard robotkernel module local loglevel.
#loglevel: verbose

# Log EEPROM content to robotkernels logging infrastructure.
#log_eeprom_data: false

#########################################################
# distributed clocks settings, sync ethercat master clock 
# to ref clock in first ethercat slave

# Log dc sync values to robotkernels logging infrastructure.
#dc_sync_log: false

# EtherCAT master timer start value. Default is to use the 
# value read out from the trigger input. Value is in [ns].
#dc_sync_timer_override: -1

# Defines how many EtherCAT cycles should be used to determine
# the average drift between master clock and dc clock.
#dc_sync_offset_compensation_cycles: 100

# The EtherCAT master can either sync the master clock to the
# dc clock (better, more accurate) or the dc clock to the master 
# clock. Values can be "ref_clock" or "master_clock".
#dc_sync_mode: ref_clock

# These values are the gains for the PI-controller to sync 
# the master clock to the dc clock. 
#dc_sync_kp: 0.0025
#dc_sync_ki: 0.0025

#########################################################
# Common settings

# With many slaves startup can spawn one thread per slave
# to decrease startup time.
#threaded_startup: true

# Use real slave names for robotkernel device names
#use_real_names: false

#########################################################
# TUN settings

# Enable EtherCAT virtual Ethernet switch for EoE and 
# Mailbox Gateway.
#tun_device_name: file:/dev/ecat_tun0

# Specify EtherCAT master IP address.
#tun_master_ip: 172.25.0.2

#########################################################
# Process data group settings. 
# Specify ethercat process data groups. Each group must have
# a unique groupt number. 
#
# A 'divider' can be specified to 
# divide the incoming trigger to a lower rate. This makes it
# possible to achieve different rates for the slaves depending 
# on your setup
#
# The timeout after which a sent packet is expected to be 
# received can be specified with 'recv_timeout'.
#
# All slaves mentioned in the list 'slaves' will be bounded to
# that process data group.
#groups: 
#  0: 
#    divisor: 1
#    recv_timeout: 1000000
#    slaves: [ 0, ]

#########################################################
# Slave settings.
# Each slave has to have a unique slave 'name'. 
#
# The 'index' reflects the slave order of the connected 
# EtherCAT slaves.
#  
# Distributed clocks 'type': Type 0 means sync0 only, 
# type 1 sync0 and sync1.
#
# Cycle time for sync0 interrupt may be specified with 
# 'cycle_time_0'. If omitted, the module's trigger cycle 
# time is used.
#
# Time for sync1 interrupt relative to sync0.
# Shift EtherCAT datagram relative to sync0.
#slaves:
#- name: my_slave_1
#  index: 0
#  dc: 
#    type: 1
#    cycle_time_0: 250000
#    cycle_time_1: 900000
#    cycle_shift: -100000
#  mapping: 
#    type: coe
#    pdos: [ 0x1600, 0x1601, 0x1A00, 0x1A01, 0x1610, 0x1611, 0x1A10, 0x1A11 ]

