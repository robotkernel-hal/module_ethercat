requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_ethercat_base
#     (optional) path to module-posix-timer-base-directory
#     e.g. /volume/software/common/packages/module_ethercat/latest
#     or to a local reltool path,
#     or to a local install like: /home/schm_fl/workspace/module_ethercat/build/sled11-x86-gcc4.x
#     defaults to rmpm structure

defines
module_ethercat_base:          %(dirname %(dirname %(CURDIR)))
module_ethercat_libdir:        %(subst "${exec_prefix}/", "", "@libdir@")
module_ethercat_libpath:       %(subst "osl42-x86_64", "$(ARCH)", "/volume/software/common/packages/libethercat/0.1.beta10/osl42-x86_64/lib:/volume/software/common/packages/libethercat/0.1.beta10/osl42-x86_64/lib64")
module_ethercat_type:          %(ifexists "%(module_ethercat_base)/../$(ARCH)", "rmpm_release", "local_install")
module_ethercat_library_path:  %(ifeq "%(module_ethercat_type)", "local_install", "%(module_ethercat_base)", "%(dirname %(module_ethercat_base))/$(ARCH)")
module_ethercat_gui_plugin:    %(module_ethercat_base)/share/robotkernel_gui/python

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_ethercat_library_path)/%(module_ethercat_libdir)

ifndef rk_libpath: rk_libpath: ""
rk_libpath: %(rk_libpath):%(module_ethercat_libpath)

ifndef rk_gui_plugin_path: rk_gui_plugin_path: ""
rk_gui_plugin_path: %(rk_gui_plugin_path):%(module_ethercat_gui_plugin)

