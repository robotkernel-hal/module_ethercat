requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_ethercat_base
#     (optional) path to module-posix-timer-base-directory
#     e.g. /volume/software/common/packages/module_ethercat/latest
#     or to a local reltool path,
#     or to a local install like: /home/schm_fl/workspace/module_ethercat/build/sled11-x86-gcc4.x
#     defaults to rmpm structure

defines
module_ethercat_base:          %(dirname %(dirname %(CURDIR)))
module_ethercat_libdir:        %(subst "${exec_prefix}/", "", "@libdir@")
module_ethercat_type:          %(ifexists "%(module_ethercat_base)/%(module_ethercat_libdir)/libmodule_ethercat.so", "local_install", "rmpm_release")
module_ethercat_library_path:  %(ifeq "%(module_ethercat_type)", "local_install", "%(_base)/%(module_ethercat_libdir)", "%(module_ethercat_base)/lib/$(ARCH)")

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_ethercat_library_path)

