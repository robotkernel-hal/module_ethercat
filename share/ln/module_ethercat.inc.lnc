requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_jr3_base
#     (optional) path to module_jr3 base directory
#     e.g. /volume/software/robotkernel/packages/module_jr3/3.0.1
#     defaults to rmpm structure
#   module_jr3_libdir
#     (optional) add custom module search paths
#   module_jr3_mds
#     (optional) add custom message definition paths

defines
module_jr3_base: %(dirname %(dirname %(CURDIR)))
module_jr3_base_type: %(ifexists "%(module_jr3_base)/lib/libmodule_jr3.so", "local_install", "rmpm_release")
module_jr3_libdir: %(ifeq "%(module_jr3_base_type)", "local_install", "%(module_jr3_base)/lib", "%(module_jr3_base)/lib/$(ARCH)")
add_message_definition_dir: %(module_jr3_base)/share/message_definitions

ifndef rk_modules: rk_modules: ""
rk_modules: %(rk_modules):%(module_jr3_libdir)

