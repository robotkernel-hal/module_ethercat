requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_ethercat_base
#     (optional) path to module_ethercat base directory
#     e.g. /volume/software/robotkernel/packages/module_ethercat/3.0.1
#     defaults to rmpm structure
#   module_ethercat_libdir
#     (optional) add custom module search paths
#   module_ethercat_mds
#     (optional) add custom message definition paths

# rk_depends: interface_process_data_inspection, interface_memory_inspection, interface_canopen_protocol, interface_sercos_protocol, interface_file_protocol

defines
module_ethercat_base: %(dirname %(dirname %(CURDIR)))
module_ethercat_base_type: %(ifexists "%(module_ethercat_base)/lib/libmodule_ethercat.so", "local_install", "rmpm_release")
module_ethercat_libdir: %(ifeq "%(module_ethercat_base_type)", "local_install", "%(module_ethercat_base)/lib", "%(module_ethercat_base)/lib/$(ARCH)")
add_message_definition_dir: %(module_ethercat_base)/share/ln/message_definitions

ifndef rk_modules: rk_modules: ""
rk_modules: %(rk_modules):%(module_ethercat_libdir)

