PTVERSION           = 2
NAME                = @PACKAGE@
VERSION             = @PACKAGE_VERSION@
DESCRIPTION         = robotkernel @PACKAGE@
MAINTAINER          = Robert Burger <robert.burger@dlr.de>
DOCUMENTATION       = https://rmintra01.robotic.dlr.de/wiki/Robotkernel/module_ethercat
DEPENDS             = robotkernel.interface_canopen_protocol, robotkernel.interface_process_data_inspection, robotkernel.interface_memory_inspection, robotkernel.interface_key_value
ARCHS               = sled11-x86-gcc4.x, sled11-x86_64-gcc4.x, vxworks6.7-x86-gcc4.x, vxworks6.8-x86-gcc4.x, vxworks6.9-x86-gcc4.x, vxworks6.9.3-x86-gcc4.x, vxworks6.9.4-x86-gcc4.x, ubuntu12.04-armhf-gcc4.x 

[install]
build/${ARCH}/install/lib => lib/${ARCH}
doc/ => doc/
share/ => share/
