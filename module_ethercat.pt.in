PTVERSION           = 2
NAME                = @PACKAGE@
VERSION             = @PACKAGE_VERSION@
DESCRIPTION         = robotkernel @PACKAGE@
MAINTAINER          = @MAINTAINER@
DOCUMENTATION       = https://rmintra01.robotic.dlr.de/wiki/Robotkernel/@PACKAGE@
DEPENDS             = robotkernel==@ROBOTKERNEL_VERSION@, service_provider_canopen_protocol==@SERVICE_PROVIDER_CANOPEN_PROTOCOL_VERSION@, service_provider_process_data_inspection==@SERVICE_PROVIDER_PROCESS_DATA_INSPECTION_VERSION@, service_provider_memory_inspection==@SERVICE_PROVIDER_MEMORY_INSPECTION_VERSION@, service_provider_file_protocol==@SERVICE_PROVIDER_FILE_PROTOCOL_VERSION@, service_provider_sercos_protocol==@SERVICE_PROVIDER_SERCOS_PROTOCOL_VERSION@ 
#DEPENDS             = robotkernel==@ROBOTKERNEL_VERSION@, service_provider_canopen_protocol==@SERVICE_PROVIDER_CANOPEN_PROTOCOL_VERSION@, service_provider_process_data_inspection==@SERVICE_PROVIDER_PROCESS_DATA_INSPECTION_VERSION@, service_provider_memory_inspection==@SERVICE_PROVIDER_MEMORY_INSPECTION_VERSION@, service_provider_key_value==@SERVICE_PROVIDER_KEY_VALUE_VERSION@, service_provider_file_protocol==@SERVICE_PROVIDER_FILE_PROTOCOL_VERSION@, service_provider_sercos_protocol==@SERVICE_PROVIDER_SERCOS_PROTOCOL_VERSION@ 
ARCHS               = @ARCHS@

[install]
build/${ARCH}/install/lib => lib/${ARCH}
doc/ => doc/
share/ => share/
