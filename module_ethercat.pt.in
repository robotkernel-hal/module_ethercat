PTVERSION           = 2
NAME                = @PACKAGE@
VERSION             = @PACKAGE_VERSION@
DESCRIPTION         = robotkernel @PACKAGE@
MAINTAINER          = Robert Burger <robert.burger@dlr.de>
DOCUMENTATION       = https://rmintra01.robotic.dlr.de/wiki/Robotkernel/module_ethercat
DEPENDS             = robotkernel.interface_canopen_protocol, robotkernel.interface_process_data_inspection, robotkernel.interface_memory_inspection, robotkernel.interface_key_value, robotkernel.interface_file_protocol
ARCHS               = @ARCHS@

[install]
build/${ARCH}/install/lib => lib/${ARCH}
doc/ => doc/
share/ => share/
